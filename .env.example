# ---- 通用 ----
NODE_ENV=development
APP_PORT=3000
APP_BASE_URL=http://localhost:3000
FRONTEND_BASE_URL=http://localhost:5173
LOG_LEVEL=info
TZ=Asia/Shanghai

# ---- 数据库 ----
DATABASE_URL=postgresql://app:app@localhost:5432/psdm?schema=public

# ---- Redis ----
REDIS_URL=redis://localhost:6379

# ---- 鉴权 ----
# 生产环境请改成随机生成的强密钥，长度至少 32 位
JWT_SECRET=change-me-in-production-min-32-chars
JWT_ACCESS_TTL=900
REFRESH_TTL=604800
BCRYPT_ROUNDS=12

# ---- 存储 ----
# local 为默认且经过验证的路径；s3 需要填写下方全部 S3_* 配置
STORAGE_DRIVER=local
STORAGE_PUBLIC_DIR=./storage/public
STORAGE_PRIVATE_DIR=./storage/private
S3_ENDPOINT=
S3_REGION=
S3_BUCKET_PUBLIC=
S3_BUCKET_PRIVATE=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# ---- 图片与隐私 ----
IMAGE_MAX_SIZE_MB=10
IMAGE_MAX_DIMENSION=8000
# 原图保留天数，到期后由定时任务彻底删除，只保留已模糊化的公开版本
ORIGINAL_RETENTION_DAYS=30
# 人脸/车牌检测是可选增强项，开启前需先安装对应依赖与模型
ENABLE_FACE_DETECTION=false
ENABLE_PLATE_DETECTION=false
FACE_CONFIDENCE_THRESHOLD=0.6
FACE_MODEL_DIR=./models/face

# 隐私检测适配器（可插拔）。留空时沿用上面的 ENABLE_* 旧开关；
# 也可显式指定，例如 DETECTION_ADAPTERS=face,plate,http
# 外部检测插件（npm 包名或本地路径，模块需默认导出 (register)=>register(adapter) ）：
# DETECTION_PLUGINS=./vendor/my-detector.js
# DETECTION_ADAPTERS=face,http
# 外部检测服务：POST 图片，返回 { boxes: [{x,y,w,h,label,confidence}] }，坐标归一化 0–1
DETECTOR_HTTP_URL=
DETECTOR_HTTP_TIMEOUT_MS=15000
DETECTOR_HTTP_TOKEN=
# 置信度自动分级阈值：≥0.85 自动模糊放行；0.55–0.85 先模糊后进人工复核；更低的仅留候选
DETECTION_AUTO_CONFIRM_THRESHOLD=0.85
DETECTION_REVIEW_THRESHOLD=0.55
DEFAULT_FUZZ_RADIUS_M=50

# ---- 地图与地理 ----
MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
MAP_TILE_ATTRIBUTION=© OpenStreetMap contributors
# nominatim 免费但有限速；国内可换成 amap 并填写 GEOCODING_API_KEY
GEOCODING_PROVIDER=nominatim
GEOCODING_API_KEY=

# ---- 邮件 ----
MAIL_DRIVER=console
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=no-reply@example.com

# ---- 业务阈值 ----
DAILY_SPOT_LIMIT=20
DAILY_COMMENT_LIMIT=30
REVIEW_SLA_HOURS=24
REPORT_SLA_HOURS=72
PRIVACY_REPORT_SLA_HOURS=24
PREMODERATE_CREDIT_THRESHOLD=60

# ---- 前端（Vite，需放在 frontend/.env 或 .env.local） ----
VITE_API_BASE_URL=http://localhost:3000/api/v1
VITE_MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
VITE_MAP_TILE_ATTRIBUTION=© OpenStreetMap contributors
VITE_DEFAULT_CENTER_LNG=121.4737
VITE_DEFAULT_CENTER_LAT=31.2304
VITE_DEFAULT_ZOOM=14
